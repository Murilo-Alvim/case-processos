# --- Banco de dados (Neon, Supabase, Railway, Render etc.) ---
# Formato: postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# --- Server ---
PORT=3333
NODE_ENV=production

# --- CORS ---
# Lista separada por vírgula de origens permitidas. Em produção,
# coloque a URL do front no Vercel. Deixe vazio para permitir tudo.
ALLOWED_ORIGINS="https://seu-front.vercel.app,http://localhost:5173"
